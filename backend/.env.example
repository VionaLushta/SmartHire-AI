# SmartHire AI backend environment
#
# Copy this file to `backend/.env` and set values for your environment.

# Database connection string used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/smarthire_db

# JWT signing key. Generate a unique value for every environment.
SECRET_KEY=change-me-before-deployment

# JWT signing algorithm.
ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public frontend URL used for redirects back to the browser app.
FRONTEND_URL=http://localhost:5173

# Official admin email allowed to register and sign in as Admin.
ADMIN_EMAIL=contact.smarthireai@proton.me

# One-time password used by the admin seeder script.
ADMIN_PASSWORD=9NAxCUwRbFt62Rd

# Public backend URL used in OAuth redirect URIs.
BACKEND_URL=http://127.0.0.1:8000

# Allowed browser origins for the React dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local upload directory for resumes and certificate files.
UPLOAD_FOLDER=app/uploads

# Local output directory for generated reports.
REPORT_FOLDER=app/reports

# SMTP settings for automated recruitment email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=viona.v.lushta@gmail.com
SMTP_PASSWORD=
SMTP_FROM=viona.v.lushta@gmail.com
SMTP_USE_TLS=true

# OAuth client credentials.
# OAuth client credentials.
GOOGLE_CLIENT_ID=48796862810-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
