# SmartHire AI frontend environment
#
# Copy this file to `frontend/.env` and set values for your environment.
#
# Important: VITE_ variables are exposed to the browser bundle, so never place
# secrets here.

# Base URL for the backend API.
VITE_API_URL=http://127.0.0.1:8000/api

# Display name used by the frontend shell and browser title.
VITE_APP_NAME=SmartHire AI

# Frontend version label.
VITE_APP_VERSION=1.0.0

# Optional feature flags for future UI flows.
VITE_FEATURE_VIDEO_INTERVIEW=false
VITE_FEATURE_OAUTH=false
VITE_FEATURE_ADVANCED_ANALYTICS=true

# Optional third-party service identifiers.
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Development-only debug toggle.
VITE_DEBUG=true
